<section
  id="histoires"
  class="stories-section relative isolate scroll-mt-16 xl:scroll-mt-[98px] bg-[#84a5ef] pt-10 pb-3 max-md:pt-7 text-[#2855dc] [--story-unit:0.95px] [--story-scene-width:2058] [&_[hidden]]:hidden!"
  aria-labelledby="stories-heading"
>
  <h2
    id="stories-heading"
    class="mb-2 text-center text-[clamp(48px,7vw,100px)] leading-[1.1] font-medium"
  >
    Histoires
  </h2>
  <p
    id="stories-status"
    class="stories-status px-6 py-16 text-center text-[#172566]"
    role="status"
  >
    Chargement des histoires...
  </p>
  <div
    id="stories-viewport"
    class="stories-viewport w-full touch-auto scroll-smooth overflow-x-auto overflow-y-hidden overscroll-x-contain [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    hidden
  >
    <div
      id="stories-flow"
      class="stories-flow relative ml-[86px] max-md:ml-5 h-[calc(660*var(--story-unit))] w-[calc(var(--story-scene-width)*var(--story-unit))]"
    >
    </div>
  </div>
</section>

<script>
  import {
    getCurrentUser,
    onAuthChange,
    type ZozzoUser,
  } from "../lib/pocketbase";
  import {
    listStories,
    getStoryLockReason,
    type StoryRecord,
  } from "../lib/stories";
  import { renderStoryCardHTML } from "../lib/storyCardUi";
  import { getStorySceneWidth, getStoryVariant } from "../lib/storyLayout";
  import { createStoryScroll } from "../lib/storyScroll";
  import { showAppToast } from "../lib/toast";

  const section = document.getElementById("histoires") as HTMLElement;
  const status = document.getElementById("stories-status") as HTMLElement;
  const viewport = document.getElementById("stories-viewport") as HTMLElement;
  const flow = document.getElementById("stories-flow") as HTMLElement;
  const scrolling = createStoryScroll(section, viewport);
  let cachedStories: StoryRecord[] | null = null;
  let generation = 0;
  let disposed = false;

  flow.addEventListener("click", (event) => {
    if ((event.target as Element).closest("[data-locked-progression]")) {
      showAppToast("Termine l'histoire précédente pour débloquer celle-ci.");
    }
  });

  function render(stories: StoryRecord[], user: ZozzoUser | null) {
    const currentGeneration = ++generation;
    scrolling.reset();
    if (!stories.length) {
      viewport.hidden = true;
      status.hidden = false;
      status.textContent =
        "Les prochaines aventures de Zozzo arrivent bientôt !";
      return;
    }
    const reasons = stories.map((story, i) =>
      getStoryLockReason(story, i, stories, user),
    );
    const firstLocked = reasons.findIndex((reason) => reason !== null);
    const cutoff =
      firstLocked < 0
        ? getStorySceneWidth(stories.length)
        : getStoryVariant(firstLocked).x;
    flow.innerHTML =
      '<div class="story-path pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#fff000_0_calc(var(--path-unlocked)*var(--story-unit)),#a4bafa_calc(var(--path-unlocked)*var(--story-unit))_100%)] mask-[url(/images/pierre.png)] mask-repeat-x mask-size-[calc(2980*var(--story-unit))_calc(640*var(--story-unit))] mask-position-[left_calc(40*var(--story-unit))]" aria-hidden="true"></div>' +
      stories
        .map((story, i) => renderStoryCardHTML(story, i, reasons[i]))
        .join("");
    flow.style.setProperty("--path-unlocked", String(cutoff));
    status.hidden = true;
    viewport.hidden = false;
    scrolling.layout(getStorySceneWidth(stories.length));
    // Explicit artwork dimensions reserve the layout while images decode.
    const images = Array.from(flow.querySelectorAll("img"));
    void Promise.allSettled([
      document.fonts.ready,
      ...images.map((image) => image.decode()),
    ]).then(() => {
      if (!disposed && currentGeneration === generation) scrolling.refresh();
    });
  }

  const unsubscribe = onAuthChange((user) => {
    if (cachedStories) render(cachedStories, user);
  });
  void listStories()
    .then((stories) => {
      if (disposed) return;
      cachedStories = stories;
      render(stories, getCurrentUser());
    })
    .catch(() => {
      if (disposed) return;
      scrolling.reset();
      viewport.hidden = true;
      status.hidden = false;
      status.textContent =
        "Impossible de charger les histoires pour le moment.";
    });
  document.addEventListener(
    "astro:before-swap",
    () => {
      disposed = true;
      generation++;
      unsubscribe();
      scrolling.destroy();
    },
    { once: true },
  );
</script>
