---
---

<section id="telecharger" class="bg-white px-6 py-16 md:px-10">
	<div class="mx-auto flex max-w-3xl flex-col items-center">
		<div class="w-full rounded-[2.5rem] bg-[var(--color-coral)] p-6 shadow-xl sm:p-10">
			<div class="mx-auto aspect-square w-full max-w-sm overflow-hidden rounded-2xl bg-black/10">
				<video
					id="bonjour-video"
					src="/video/bonjour_hjynwqpkm5.mp4"
					autoplay
					muted
					loop
					playsinline
					class="h-full w-full object-cover"
				>
				</video>
			</div>
		</div>
		<button
			id="bonjour-replay"
			type="button"
			class="mt-6 rounded-full bg-[var(--color-royal-blue)] px-7 py-3 text-base font-semibold text-white transition-transform duration-200 hover:scale-[1.02]"
		>
			ZOZZO te dit bonjour
		</button>
	</div>
</section>

<script>
	const btn = document.getElementById('bonjour-replay');
	const video = document.getElementById('bonjour-video') as HTMLVideoElement | null;

	btn?.addEventListener('click', () => {
		if (!video) return;
		video.currentTime = 0;
		void video.play();
	});
</script>
