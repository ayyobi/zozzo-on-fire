---
---

<section id="telecharger" class="hello-section bg-white px-6 py-16 md:px-10">
	<div class="mx-auto flex max-w-3xl flex-col items-center">
		<div class="w-full rounded-[2.5rem] p-6 sm:p-10">
			<div class="relative mx-auto aspect-square w-full max-w-sm overflow-hidden rounded-2xl bg-white/20">
				<video
					id="bonjour-animation"
					src="/video/bonjour.mp4"
					aria-label="Zozzo signe Bonjour en langue des signes française"
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					width="640"
					height="640"
					class="absolute inset-0 h-full w-full object-contain"
				></video>
			</div>
		</div>
		<button
			id="bonjour-replay"
			type="button"
			class="mt-6 rounded-full bg-[var(--color-royal-blue)] px-7 py-3 text-base font-semibold text-white transition-transform duration-200 hover:scale-[1.02]"
		>
			ZOZZO te dit bonjour
		</button>
	</div>
</section>

<style>
	.hello-section { padding: clamp(32px, 5vw, 64px) 0 32px; }
	.hello-section > div { max-width: none; }
	.hello-section > div > div { width: 62%; max-width: 800px; height: auto; padding: clamp(24px, 4vw, 48px); border-radius: 32px; }
	.hello-section > div > div > div { width: min(30vw, 360px); max-width: 100%; border-radius: 0; }
	button { margin-top: 20px; padding: 14px 22px; border-radius: 0; background: #2447d5; color: #f3e63e; font-size: 18px; font-weight: 400; }
	@media (max-width: 640px) {
		.hello-section { padding: 32px 20px; }
		.hello-section > div > div { width: 100%; max-width: 360px; padding: 24px; border-radius: 28px; }
		.hello-section > div > div > div { width: 100%; max-width: 220px; }
		button { margin: 18px 0 0; padding: 16px 20px; font-size: 18px; }
	}

@media (min-width: 1024px) {
button { padding: 12px 22px; font-size: var(--desktop-button); }
}
</style>

<script>
	const btn = document.getElementById('bonjour-replay');
	const animation = document.getElementById('bonjour-animation') as HTMLVideoElement | null;

	btn?.addEventListener('click', () => {
		if (!animation) return;
		animation.currentTime = 0;
		void animation.play().catch(() => { animation.controls = true; });
	});
</script>
