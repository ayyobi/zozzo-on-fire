<section class="relative bg-white px-6 pt-12 pb-0 md:px-10 lg:pt-16">
	<div class="mx-auto grid max-w-7xl items-start gap-10 lg:grid-cols-2 lg:gap-8">
		<div class="rounded-[2.5rem] bg-[var(--color-pale-pink)] px-8 py-10 sm:px-12 sm:py-12 lg:max-w-xl">
			<h1 class="text-4xl font-normal text-neutral-900 sm:text-5xl lg:text-6xl">
