---
const bonuses = [
	{ id: 'bol', icon: '/images/icon/bol.svg', label: 'Bonus' },
	{ id: 'potion', icon: '/images/icon/potion.svg', label: 'Potion' },
	{ id: 'bonbon', icon: '/images/icon/bonbon.svg', label: 'Bonbon' },
	{ id: 'fleur', icon: '/images/icon/fleur.svg', label: 'Fleur' },
];
---

<div class="bonus-bar flex h-[136px] w-full items-center justify-between gap-5 rounded-[42px] bg-[#f96346] py-2.5 pr-[42px] pl-6 max-md:h-20 max-md:gap-2 max-md:rounded-3xl max-md:px-3" role="group" aria-label="Objets à débloquer après chaque histoire">
	{
		bonuses.map((bonus, index) => (
			<button
				type="button"
				data-bonus-id={bonus.id}
				data-bonus-label={bonus.label}
				aria-label={`${bonus.label} verrouillé — termine ${index + 1} histoire${index ? 's' : ''} pour le débloquer`}
				title={`Termine ${index + 1} histoire${index ? 's' : ''} pour débloquer cet objet`}
				disabled
				class="bonus-item max-md:size-[58px] max-md:[&>img]:h-[58px] max-md:[&>img]:max-w-[64px] max-md:first:[&>img]:h-12 grid size-[116px] shrink-0 place-items-center rounded-full transition-transform duration-150 disabled:cursor-not-allowed enabled:hover:-translate-y-1 enabled:hover:scale-105 enabled:active:scale-95 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#2453f5] [&>img]:col-start-1 [&>img]:row-start-1 [&>img]:h-[116px] [&>img]:w-auto [&>img]:max-w-[132px] [&>img]:object-contain first:[&>img]:h-[94px] enabled:[&>.bonus-lock]:hidden motion-reduce:transition-none motion-reduce:enabled:hover:transform-none motion-reduce:enabled:active:transform-none"
			>
				<img src={bonus.icon} alt="" />
				<svg class="bonus-lock pointer-events-none z-1 col-start-1 row-start-1 block h-[58px] w-9 max-md:h-8 max-md:w-5 min-w-[22px] max-w-none overflow-visible" width="22" height="35" viewBox="0 0 40 64" fill="none" aria-hidden="true">
					<path d="M5 30V21C5 10 11 3 20 3S35 10 35 21V30" stroke="#fff000" stroke-width="3" />
					<path d="M5 30V21C5 10 11 3 20 3S35 10 35 21V30" stroke="#2453f5" stroke-width="1" />
					<path d="M2 29H38V62H2Z" fill="#fff000" stroke="#e3ca00" />
					<path d="M24 43a4 4 0 1 0-7 2l-2 9h10l-2-9a4 4 0 0 0 1-2Z" fill="#2453f5" />
				</svg>
			</button>
		))
	}
</div>
<p class="bonus-status sr-only" role="status" aria-live="polite">Termine une histoire pour débloquer un objet !</p>

<script>
	import { onAuthChange } from '../lib/pocketbase';
	import { countCompletedStories } from '../lib/bonusProgress';

	const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-bonus-id]'));
	const status = document.querySelector<HTMLElement>('.bonus-status');

	onAuthChange((user) => {
		const completed = countCompletedStories(user?.histoires_terminees);
		items.forEach((item, index) => {
			const unlocked = completed > index;
			const label = item.dataset.bonusLabel;
			const hint = unlocked
				? `${label} débloqué !`
				: `${label} verrouillé — termine ${index + 1} histoire${index ? 's' : ''} pour le débloquer`;
			item.disabled = !unlocked;
			item.setAttribute('aria-label', hint);
			item.title = hint;
		});
		if (status) status.textContent = completed === 0
			? 'Termine une histoire pour débloquer un objet !'
			: completed >= items.length
				? 'Bravo, tu as débloqué tous les objets !'
				: `${completed} objet${completed > 1 ? 's' : ''} débloqué${completed > 1 ? 's' : ''} ! Termine une nouvelle histoire pour gagner le suivant.`;
	});

	items.forEach((item) => item.addEventListener('click', () => {
		if (!item.disabled && status) status.textContent = `${item.dataset.bonusLabel} fait partie de ta collection !`;
	}));
</script>
