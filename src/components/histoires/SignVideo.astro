<template id="sign-video-template">
  <div class="absolute overflow-hidden" data-sign-placement>
    <video
      class="sign-video-media size-full object-contain"
      autoplay
      muted
      loop
      playsinline
      controls
      preload="metadata"></video>
    <p
      class="absolute inset-0 hidden place-content-center p-1 text-center text-xs text-neutral-700"
      data-media-error
      role="status"
    >
      Vidéo indisponible
    </p>
  </div>
</template>
