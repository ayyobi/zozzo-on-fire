<section id="story-reward" class="hidden px-4 py-4 text-center" aria-labelledby="reward-title">
	<h2 id="reward-title" tabindex="-1" class="text-2xl font-semibold text-[#2439a7]">Bravo, tu as terminé l’histoire !</h2>
	<p id="story-save-status" role="status" class="mt-2 text-sm text-neutral-700"></p>
	<button id="story-save-retry" type="button" class="mt-2 hidden min-h-11 rounded-full border-2 border-[#2439a7] px-5 text-[#2439a7]">Réessayer l’enregistrement</button>
	<div class="mt-4 flex flex-wrap justify-center gap-3">
		<button id="story-replay" type="button" class="min-h-12 rounded-full bg-[#fff000] px-6 py-3 font-semibold text-[#2439a7]">Relire l’histoire</button>
		<a href="/app#histoires" class="min-h-12 rounded-full bg-[#2439a7] px-6 py-3 font-semibold text-white">Retour aux histoires</a>
	</div>
</section>
