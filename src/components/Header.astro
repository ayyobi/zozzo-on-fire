---
const navLinks = [
  { href: "/#accueil", label: "Accueil" },
  { href: "/fonctionnalites", label: "Fonctionnalités" },
  { href: "/a-propos", label: "À propos" },
  { href: "/contact", label: "Contact" },
];

const LINK_BASE_DELAY = 100;
const LINK_DELAY_STEP = 50;
---

<header
  data-menu-open="false"
  class="landing-header sticky top-0 z-50 header-layout bg-[var(--color-pale-pink)]"
>
  <div
    id="topbar"
    class="relative z-50 mx-auto flex max-w-7xl items-center justify-between bg-[var(--color-pale-pink)] px-6 py-4 transition-colors duration-300 md:px-10"
  >
    <a href="/#accueil" class="shrink-0">
      <img src="/images/zozzo-logo.svg" alt="ZOZZO" class="logo-image" />
    </a>

    <nav
      class="hidden items-center gap-8 md:flex"
      aria-label="Navigation principale"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-base font-medium text-neutral-800 transition-colors hover:text-[var(--color-coral)]"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/login"
      class="hidden rounded-full bg-[var(--color-blue)] px-5 py-2 text-base font-semibold text-white transition-transform duration-200 hover:scale-[1.02] md:inline-block"
    >
      Essayez gratuitement
    </a>

    <button
      id="burger-btn"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-open="false"
      data-mobile-burger
      class="relative z-50 flex h-11 w-11 shrink-0 flex-col items-center justify-center gap-[7px] md:hidden"
    >
      <span
        data-line="top"
        class="block h-0.5 w-6 rounded-full bg-[var(--color-coral)] transition-all duration-[380ms] ease-[cubic-bezier(0.65,0,0.35,1)]"
      ></span>
      <span
        data-line="mid"
        class="block h-0.5 w-6 rounded-full bg-[var(--color-coral)] transition-all duration-[220ms] ease-[cubic-bezier(0.65,0,0.35,1)]"
      ></span>
      <span
        data-line="bottom"
        class="block h-0.5 w-6 rounded-full bg-[var(--color-coral)] transition-all duration-[380ms] ease-[cubic-bezier(0.65,0,0.35,1)]"
      ></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    data-open="false"
    data-mobile-panel
    class="fixed inset-0 z-40 hidden origin-top flex-col bg-[var(--color-pale-pink)] transition-all duration-[420ms] ease-[cubic-bezier(0.65,0,0.35,1)] md:hidden"
  >
    <nav
      class="flex flex-1 flex-col items-start justify-center gap-1 px-8 pt-20 pb-12"
      aria-label="Navigation mobile"
    >
      {
        navLinks.map((link, i) => (
          <div class="overflow-hidden py-2">
            <a
              href={link.href}
              data-mobile-link
              class="group inline-flex translate-y-full items-center gap-3 text-3xl font-normal text-neutral-900 opacity-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] sm:text-4xl"
              style={`transition-delay: ${LINK_BASE_DELAY + i * LINK_DELAY_STEP}ms`}
            >
              {link.label}
              <span class="-translate-x-2 text-2xl opacity-0 transition-all duration-[250ms] ease-out group-hover:translate-x-0 group-hover:opacity-100">
                →
              </span>
            </a>
          </div>
        ))
      }

      <div class="mt-6 overflow-hidden py-2">
        <a
          href="/login"
          data-mobile-link
          class="inline-block translate-y-full rounded-full bg-[var(--color-yellow)] px-8 py-3.5 text-lg font-normal text-[var(--color-coral)] opacity-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
          style={`transition-delay: ${LINK_BASE_DELAY + navLinks.length * LINK_DELAY_STEP}ms`}
        >
          Essayer gratuitement
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { initMobileMenu } from "../lib/mobileMenu";

  const header = document.querySelector("header") as HTMLElement;
  const burgerBtn = document.getElementById("burger-btn") as HTMLButtonElement;
  const panel = document.getElementById("mobile-menu") as HTMLElement;

  const menu = initMobileMenu({ header, burgerBtn, panel });

  menu.mobileLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const href = link.getAttribute("href") ?? "";
      menu.close(() => {
        const isSamePageAnchor =
          href.startsWith("/#") && window.location.pathname === "/";
        if (isSamePageAnchor) {
          const hash = href.slice(1);
          document
            .querySelector(hash)
            ?.scrollIntoView({ behavior: "smooth", block: "start" });
          history.pushState(null, "", hash);
        } else {
          window.location.href = href;
        }
      });
    });
  });
</script>

<style>
  .header-layout #topbar {
    max-width: none;
    height: 82px;
    padding: 0 clamp(24px, 3vw, 56px);
    gap: 24px;
  }
  .header-layout #topbar > a:first-child {
    display: flex;
    align-items: center;
  }
  .header-layout .logo-image {
    display: block;
    width: 122px;
    height: auto;
  }
  .header-layout nav[aria-label="Navigation principale"] {
    margin-left: auto;
    margin-right: clamp(0px, 3vw, 48px);
    gap: clamp(20px, 3vw, 44px);
  }
  .header-layout nav[aria-label="Navigation principale"] a {
    font-size: 16px;
    font-weight: 400;
    color: black;
    white-space: nowrap;
  }
  .header-layout nav[aria-label="Navigation principale"] a:last-child {
    display: none;
  }
  .header-layout #topbar > a:last-of-type {
    flex-shrink: 0;
    padding: 13px 22px;
    font-size: 16px;
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .header-layout #topbar {
      height: 72px;
      padding: 0 24px;
    }
    .header-layout .logo-image {
      width: 112px;
    }
  }

  .landing-header #topbar {
    background: #fcded6;
  }
  .landing-header #topbar > a:last-of-type {
    background: #84a5f2;
    color: #f3e63e;
  }
  @media (max-width: 767px) {
    .landing-header #mobile-menu nav {
      margin: 0;
      gap: 4px;
    }
    .landing-header #mobile-menu nav a[data-mobile-link] {
      font-size: 30px;
    }
  }
  /* Burger↔X transform and panel reveal are shared global rules — see
     [data-mobile-burger] / [data-mobile-panel] in src/styles/global.css. */

  /* Keep the topbar continuous with the pale-pink full-screen menu. */
  header[data-menu-open="true"] #topbar {
    background-color: transparent;
  }
  header[data-menu-open="true"] #burger-btn [data-line] {
    background-color: var(--color-coral);
  }

  @media (min-width: 1024px) {
    .header-layout nav[aria-label="Navigation principale"] a {
      font-size: 14px;
    }
    .header-layout #topbar > a:last-of-type {
      padding: 12px 20px;
      font-size: 14px;
    }
  }
</style>
