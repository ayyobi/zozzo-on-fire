---
interface Props { variant?: 'home' | 'default'; }
const { variant = 'default' } = Astro.props;
---

<footer class:list={["bg-[var(--color-yellow)] px-6 py-12 md:px-10", { 'landing-footer': variant === 'home' }]}>
	<div class="mx-auto max-w-6xl">
		<nav class="flex flex-col gap-3 text-base font-semibold text-[var(--color-royal-blue)] sm:text-lg" aria-label="Liens du pied de page">
			<a href="/fonctionnalites" class="w-fit transition-colors hover:text-white">Fonctionnalités</a>
			<a href="/a-propos" class="w-fit transition-colors hover:text-white">À propos</a>
			<a href="/contact" class="w-fit transition-colors hover:text-white">Contact</a>
		</nav>

		<hr class="my-8 border-neutral-900/20" />

		<nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-[var(--color-royal-blue)] sm:text-base" aria-label="Mentions légales">
			<a href="/conditions-generales" class="transition-colors hover:text-white">Conditions Générales</a>
			<a href="/mentions-legales" class="transition-colors hover:text-white">Mentions légales</a>
			<a href="/donnees-personnelles" class="transition-colors hover:text-white">Données personnelles</a>
			<a href="/cookies" class="transition-colors hover:text-white">Gérer mes cookies</a>
			<a href="/cookies" class="transition-colors hover:text-white">Politique cookies</a>
		</nav>
	</div>
</footer>

<style>
	.landing-footer { background: #f3e63e; padding: 2.4vw 3.7vw 1.6vw; color: #718fbb; }
	.landing-footer > div { max-width: none; }
	.landing-footer nav:first-child { gap: 2.5vw; font-size: 1.8vw; font-weight: 400; color: #718fbb; }
	.landing-footer hr { margin: 3.2vw 0 2vw; border-color: #718fbb80; }
	.landing-footer nav:last-child { justify-content: space-around; gap: 1vw; font-size: 1.05vw; color: #718fbb; }
	@media (max-width: 640px) {
		.landing-footer { padding: 30px 24px; }
		.landing-footer nav:first-child { gap: 18px; font-size: 17px; }
		.landing-footer hr { margin: 24px 0; }
		.landing-footer nav:last-child { justify-content: flex-start; gap: 14px 22px; font-size: 12px; }
	}

@media (min-width: 1024px) {
.landing-footer nav:first-child { font-size: 16px; gap: 20px; }
.landing-footer nav:last-child { font-size: 13px; }
}
</style>
