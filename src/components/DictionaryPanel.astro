---
// Mini dictionary preview shown on the app home. Real search against
// PocketBase's `signes` collection, capped to a handful of results — the
// full browsing experience lives on /dictionnaire.
---

<section class="dictionary-panel flex h-[clamp(440px,62vh,682px)] w-full flex-col overflow-hidden max-xl:h-[420px] max-xl:rounded-3xl max-xl:[&_.dico-card>span:not(.absolute):first-of-type]:h-[104px] max-xl:[&_.dico-card>span:not(.absolute):first-of-type]:rounded-2xl max-xl:[&_.dico-card>span.absolute+span]:h-[104px] max-xl:[&_.dico-card>span.absolute+span]:rounded-2xl max-xl:[&_.dico-card>span:last-child]:text-[16px] max-xl:[&_.dico-card>span:last-child]:leading-6 max-xl:[&_.dico-card_img]:p-2 rounded-[36px] bg-white text-[#2450ef] [&_.dico-card]:gap-0 [&_.dico-card]:rounded-none [&_.dico-card]:border-0 [&_.dico-card]:bg-transparent [&_.dico-card]:p-0 [&_.dico-card]:shadow-none [&_.dico-card>span:not(.absolute):first-of-type]:h-[154px] [&_.dico-card>span:not(.absolute):first-of-type]:rounded-[28px] [&_.dico-card>span:not(.absolute):first-of-type]:border-3 [&_.dico-card>span:not(.absolute):first-of-type]:border-[#2850ff] [&_.dico-card>span:not(.absolute):first-of-type]:bg-white [&_.dico-card>span.absolute+span]:h-[154px] [&_.dico-card>span.absolute+span]:rounded-[28px] [&_.dico-card>span.absolute+span]:border-3 [&_.dico-card>span.absolute+span]:border-[#2850ff] [&_.dico-card>span.absolute+span]:bg-white [&_.dico-card_img]:min-h-0 [&_.dico-card_img]:object-contain [&_.dico-card_img]:p-4 [&_.dico-card>span:last-child]:text-[22px] [&_.dico-card>span:last-child]:leading-8 [&_.dico-card>span:last-child]:font-normal [&_.dico-card>span:last-child]:text-[#2047ff]" aria-labelledby="dico-title">
	<h2 id="dico-title" class="shrink-0 mx-[clamp(16px,2.6vw,38px)] mt-[clamp(14px,2vh,20px)] text-[clamp(28px,3vw,44px)] max-xl:mx-5 max-xl:mt-4 max-xl:text-[28px] leading-[1.4] font-normal">Dico</h2>

	<label class="dictionary-search shrink-0 max-xl:mx-5 max-xl:mb-5 max-xl:h-9 max-xl:px-3 max-xl:[&_input]:text-[16px] max-xl:[&_svg]:size-5 mt-0 mr-[clamp(14px,2.3vw,34px)] mb-[clamp(14px,2.4vh,34px)] ml-[clamp(16px,2.6vw,38px)] flex h-[clamp(30px,3.2vh,42px)] items-center gap-2 rounded-full bg-[#eceaea] px-[clamp(12px,1.4vw,18px)] text-[#aaa] focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-[#2450ef] [&_input]:text-[22px] [&_input]:text-[#303030] [&_input]:placeholder:text-[#aaa] [&_svg]:size-7 [&_svg]:shrink-0">
		<span class="sr-only">Rechercher un signe</span>
		<input
			id="dico-search"
			type="search"
			placeholder="amour"
			class="w-full min-w-0 bg-transparent outline-none"
		/>
		<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="10" cy="10" r="6.5" stroke="currentColor" stroke-width="3" /><path d="m15 15 5 6" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
	</label>

	<div class="dictionary-scroll min-h-0 flex-1 max-xl:px-4 max-xl:pb-4 overflow-y-auto px-[clamp(12px,1.8vw,26px)] pb-[clamp(16px,2vh,26px)] [scrollbar-width:thin] [scrollbar-color:#c5d1ff_transparent]">
	<p id="dico-status" class="mt-4 hidden text-center text-sm text-neutral-400"></p>
	<div id="dico-results" class="dictionary-results max-xl:gap-x-3 max-xl:gap-y-4 grid grid-cols-2 gap-x-2.5 gap-y-[26px]"></div>

	<a
		href="/dictionnaire"
		class="dictionary-more max-xl:text-[16px] mt-4 block text-center text-[20px] hover:underline"
	>
		Voir le dictionnaire →
	</a>
</div>
</section>

<script>
	import { attachDictionaryController } from '../lib/dictionaryController';
	import { getCurrentUser } from '../lib/pocketbase';
	import { initSignModal } from '../lib/signModal';

	const searchInput = document.getElementById('dico-search') as HTMLInputElement;
	const resultsEl = document.getElementById('dico-results') as HTMLElement;
	const statusEl = document.getElementById('dico-status') as HTMLElement;

	const modal = initSignModal(getCurrentUser);

	attachDictionaryController({
		searchInput,
		resultsEl,
		statusEl,
		limit: 8,
		getUser: getCurrentUser,
		onCardClick: (sign) => modal.show(sign),
	});
</script>
