---
// Mini dictionary preview shown on the app home. Real search against
// PocketBase's `signes` collection, capped to a handful of results — the
// full browsing experience lives on /dictionnaire.
---

<section class="dictionary-panel" aria-labelledby="dico-title">
	<h2 id="dico-title">Dico</h2>

	<label class="dictionary-search">
		<span class="sr-only">Rechercher un signe</span>
		<input
			id="dico-search"
			type="search"
			placeholder="amour"
			class="w-full min-w-0 bg-transparent outline-none"
		/>
		<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="10" cy="10" r="6.5" stroke="currentColor" stroke-width="3" /><path d="m15 15 5 6" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg>
	</label>

	<div class="dictionary-scroll">
	<p id="dico-status" class="mt-4 hidden text-center text-sm text-neutral-400"></p>
	<div id="dico-results" class="dictionary-results"></div>

	<a
		href="/dictionnaire"
		class="dictionary-more"
	>
		Voir le dictionnaire →
	</a>
</div>
</section>

<script>
	import { attachDictionaryController } from '../lib/dictionaryController';
	import { getCurrentUser } from '../lib/pocketbase';
	import { initSignModal } from '../lib/signModal';

	const searchInput = document.getElementById('dico-search') as HTMLInputElement;
	const resultsEl = document.getElementById('dico-results') as HTMLElement;
	const statusEl = document.getElementById('dico-status') as HTMLElement;

	const modal = initSignModal(getCurrentUser);

	attachDictionaryController({
		searchInput,
		resultsEl,
		statusEl,
		limit: 8,
		getUser: getCurrentUser,
		onCardClick: (sign) => modal.show(sign),
	});
</script>

<style>
.dictionary-panel { height: 414px; width: 100%; overflow: hidden; border-radius: 22px; background: white; color: #2450ef; }
#dico-title { margin: 12px 23px 0; font-size: 28px; font-weight: 400; line-height: 1.4; }
.dictionary-search { display: flex; align-items: center; gap: 8px; height: 26px; margin: 0 20px 21px 23px; padding: 0 11px; border-radius: 999px; background: #eceaea; color: #aaa; }
.dictionary-search input { font-size: 14px; color: #303030; }
.dictionary-search input::placeholder { color: #aaa; }
.dictionary-search svg { flex-shrink: 0; }
.dictionary-search:focus-within { outline: 2px solid #2450ef; outline-offset: 2px; }
.dictionary-scroll { height: 316px; padding: 0 16px 16px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: #c5d1ff transparent; }
.dictionary-results { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 6px; }
.dictionary-panel :global(.dico-card) { gap: 0; border: 0; border-radius: 0; padding: 0; background: transparent; box-shadow: none; }
.dictionary-panel :global(.dico-card > span:first-of-type:not(.absolute)) ,
.dictionary-panel :global(.dico-card > span.absolute + span) { height: 94px; border: 2px solid #2850ff; border-radius: 17px; background: white; }
.dictionary-panel :global(.dico-card img) { object-fit: contain; padding: 10px; }
.dictionary-panel :global(.dico-card > span:last-child) { color: #2047ff; font-size: 14px; font-weight: 400; line-height: 20px; }
.dictionary-more { display: block; margin-top: 16px; font-size: 13px; text-align: center; }
.dictionary-more:hover { text-decoration: underline; }
</style>
