---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="ZOZZO | Essayer gratuitement" description="La nouvelle version de Zozzo arrive le 23 septembre. Rendez-vous bientôt pour apprendre la langue des signes en s’amusant !">
	<Header variant="home" />
	<main class="release-page">
		<section class="release-card" aria-labelledby="release-title">
			<div class="release-art">
				<img src="/images/zozzo-head.avif" alt="Zozzo vous donne rendez-vous bientôt" width="476" height="468" />
				<span class="star star-one" aria-hidden="true">✦</span>
				<span class="star star-two" aria-hidden="true">✦</span>
			</div>
			<div class="release-copy">
				<p class="eyebrow">Essayer gratuitement</p>
				<h1 id="release-title">Zozzo revient bientôt !</h1>
				<p class="announcement">La nouvelle version de Zozzo sortira le <strong>23 septembre</strong>.</p>
				<p>Encore un peu de patience ! Rendez-vous le 23 septembre pour découvrir la nouvelle version et apprendre la langue des signes en s’amusant.</p>
				<a class="release-button" href="/fonctionnalites">Découvrir les fonctionnalités <span aria-hidden="true">→</span></a>
				<a class="home-link" href="/">Retour à l’accueil</a>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.release-page { display: grid; place-items: center; min-height: calc(100svh - 82px); padding: 64px 24px; background: #fcded6; }
	.release-card { display: grid; grid-template-columns: .9fr 1.1fr; align-items: center; width: 100%; max-width: 1000px; overflow: hidden; border-radius: 32px; background: white; }
	.release-art { position: relative; display: grid; place-items: center; align-self: stretch; min-height: 460px; padding: 40px; background: #84a5f2; }
	.release-art img { width: 100%; max-width: 300px; height: auto; }
	.star { position: absolute; color: #f3e63e; font-size: 56px; line-height: 1; }
	.star-one { top: 32px; right: 28px; }
	.star-two { bottom: 32px; left: 28px; font-size: 36px; }
	.release-copy { padding: 48px 40px; color: #202020; }
	.eyebrow { width: fit-content; margin-bottom: 20px; padding: 7px 14px; border-radius: 30px; background: #f3e63e; font-size: 14px; }
	h1 { margin-bottom: 24px; font-size: clamp(28px, 3vw, 40px); line-height: 1.15; font-weight: 500; }
	p { font-size: 16px; line-height: 1.6; }
	.announcement { margin-bottom: 16px; font-size: 20px; line-height: 1.4; }
	.announcement strong { white-space: nowrap; }
	.release-button { display: inline-flex; align-items: center; justify-content: center; gap: 12px; margin-top: 28px; padding: 13px 20px; border-radius: 30px; background: #f26748; color: #171717; font-size: 16px; font-weight: 500; }
	.release-button:hover { background: #e95b3c; }
	.home-link { display: block; width: fit-content; margin-top: 20px; font-size: 14px; color: #072b7a; text-decoration: underline; text-underline-offset: 4px; }
	@media (max-width: 767px) {
		.release-page { min-height: calc(100svh - 72px); padding: 28px 20px 40px; }
		.release-card { grid-template-columns: 1fr; max-width: 500px; border-radius: 24px; }
		.release-art { min-height: 0; padding: 24px; }
		.release-art img { max-width: 180px; }
		.release-copy { padding: 28px 24px; }
		.release-button { font-size: 15px; padding: 12px 16px; }
	}
</style>
