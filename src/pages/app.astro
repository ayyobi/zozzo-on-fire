---
import AppLayout from '../layouts/AppLayout.astro';
import UserCharacter from '../components/UserCharacter.astro';
import UserQuickProfile from '../components/UserQuickProfile.astro';
import DictionaryPanel from '../components/DictionaryPanel.astro';
import BonusBar from '../components/BonusBar.astro';
import StoriesSection from '../components/StoriesSection.astro';
import LessonsSection from '../components/LessonsSection.astro';
import CahierSection from '../components/CahierSection.astro';
import MiniJeuxSection from '../components/MiniJeuxSection.astro';
import SignModal from '../components/SignModal.astro';
import AvatarPickerModal from '../components/AvatarPickerModal.astro';
---

<AppLayout home title="ZOZZO | Accueil" description="Ton espace ZOZZO." loadingText="Chargement de ton espace ZOZZO...">
	<div class="app-home-viewport overflow-x-auto bg-[#fcdfd7]">
	<main id="app-content" class="app-home mx-auto box-border grid w-full max-w-[1440px] grid-cols-[minmax(0,410px)_minmax(0,1fr)_minmax(0,336px)] items-start gap-x-[clamp(20px,3vw,64px)] gap-y-[clamp(24px,3vh,54px)] px-[clamp(20px,4vw,64px)] pt-[clamp(28px,6vh,70px)] pb-11 md:max-xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:max-xl:gap-x-6 md:max-xl:gap-y-4 md:max-xl:px-6 md:max-xl:py-6 max-md:grid-cols-1 max-md:gap-4 max-md:px-4 max-md:pt-5 max-md:pb-6 [&:not(.hidden)]:grid hidden">
		<div class="app-dictionary min-w-0 md:max-xl:col-start-1 md:max-xl:row-start-1 md:max-xl:row-span-3 max-md:row-start-4 max-md:w-full max-md:max-w-[420px] max-md:justify-self-center">
			<DictionaryPanel />
		</div>

		<div class="app-character min-w-0 w-full self-center md:max-xl:col-start-2 md:max-xl:row-start-2 max-md:row-start-2">
			<UserCharacter />
		</div>

		<div class="app-profile min-w-0 pt-[clamp(12px,4vh,54px)] md:max-xl:col-start-2 md:max-xl:row-start-1 max-md:row-start-1 max-xl:pt-0">
			<UserQuickProfile />
		</div>

		<div class="app-bonus col-span-full w-full max-w-[640px] justify-self-center md:max-xl:col-span-1 md:max-xl:col-start-2 md:max-xl:row-start-3 max-md:row-start-3 max-md:max-w-[420px]">
			<BonusBar />
		</div>
	</main>
	</div>

	<StoriesSection />
	<LessonsSection />
	<CahierSection />
	<MiniJeuxSection />

	<SignModal />
	<AvatarPickerModal />

	<script>
		import { checkAppSession, watchAppSession } from '../lib/appPage';
		import { getCurrentUser, type ZozzoUser } from '../lib/pocketbase';
		import { getAvatarImageUrl, resolveDisplayAvatar, type AvatarRecord } from '../lib/avatars';
		import { initAvatarPicker } from '../lib/avatarPickerModal';
		import { initAppScroll } from '../lib/appScroll';

		initAppScroll();

		const loading = document.getElementById('loading') as HTMLElement;
		const networkWarning = document.getElementById('network-warning') as HTMLElement;
		const content = document.getElementById('app-content') as HTMLElement;
		const avatarCircle = document.getElementById('user-avatar-circle') as HTMLButtonElement;
		const avatarImg = document.getElementById('user-avatar-img') as HTMLImageElement;
		const pseudoEl = document.getElementById('user-pseudo') as HTMLElement;

		async function applyAvatar(avatar: AvatarRecord | undefined, pseudo: string) {
			const resolved = await resolveDisplayAvatar(avatar);
			const url = getAvatarImageUrl(resolved);
			if (url) {
				avatarImg.src = url;
				avatarImg.alt = `Avatar de ${pseudo}`;
			}
		}

		function renderUser(user: ZozzoUser) {
			pseudoEl.textContent = user.pseudo || '—';
			void applyAvatar(user.expand?.avatar as AvatarRecord | undefined, user.pseudo);
		}

		const avatarPicker = initAvatarPicker((avatar) => {
			const user = getCurrentUser();
			applyAvatar(avatar, user?.pseudo ?? '');
		});

		avatarCircle.addEventListener('click', () => avatarPicker.open());

		async function init() {
			const user = await checkAppSession(networkWarning);
			if (!user) return;

			renderUser(user);
			loading.classList.add('hidden');
			content.classList.remove('hidden');

			// Only players landing here right after creating an account get
			// the "choose your avatar" popup — not everyone who simply
			// hasn't picked one yet. inscription.astro redirects to
			// /app?bienvenue=1 for that one-time case.
			const params = new URLSearchParams(window.location.search);
			if (params.get('bienvenue') === '1') {
				history.replaceState(null, '', '/app');
				avatarPicker.open();
			}
		}

		init();

		watchAppSession((user) => {
			if (!content.classList.contains('hidden')) {
				renderUser(user);
			}
		});
	</script>
</AppLayout>
