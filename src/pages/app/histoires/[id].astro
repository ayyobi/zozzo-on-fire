---
// Dynamic story reader — ONE file handles every story (no per-title .astro
// file), matching the "add a story in PocketBase, don't hand-author a
// page" requirement. Routed by PocketBase's own record `id` — `histoires`
// has no `slug` field (confirmed against the live schema), so there's no
// pretty-slug option unless one gets added later.
//
// IMPORTANT (static site, no SSR/adapter): getStaticPaths() below runs at
// `npm run build` time, not per-request, so it needs to fetch the list of
// stories from PocketBase with NO logged-in user (the build itself isn't
// authenticated as anyone). This works today because `histoires` is
// publicly readable — if that ever gets locked down, this build-time
// fetch will fail and no story pages will be generated (see the report).
//
// The actual scene content, lock/progression state, etc. are still fetched
// client-side with the real logged-in session (same pattern as the rest of
// the app) — getStaticPaths only decides which URLs exist.
import PocketBase from 'pocketbase';
import AppLayout from '../../../layouts/AppLayout.astro';

export async function getStaticPaths() {
	const buildPb = new PocketBase(import.meta.env.PUBLIC_POCKETBASE_URL);
	try {
		const stories = await buildPb.collection('histoires').getFullList({ sort: 'ordre' });
		return stories.map((story) => ({ params: { id: story.id } }));
	} catch {
		// Build-time fetch failed (offline build, collection no longer
		// public, etc.): build with zero story pages rather than failing the
		// whole site build.
		return [];
	}
}
---

<AppLayout title="ZOZZO | Histoire" description="Une histoire ZOZZO." loadingText="Chargement de l'histoire...">
	<main id="story-content" class="hidden bg-[var(--color-blue)] px-4 py-10 sm:px-6 lg:py-14">
		<div class="mx-auto max-w-2xl">
			<a href="/app#histoires" class="mb-6 inline-block text-sm font-medium text-[var(--color-royal-blue)] hover:underline">
				&larr; Retour aux histoires
			</a>

			<div id="story-not-found" class="hidden rounded-3xl bg-white p-8 text-center shadow-lg">
				<p class="text-lg font-medium text-neutral-800">Cette histoire n'existe pas.</p>
				<a
					href="/app#histoires"
					class="mt-5 inline-block rounded-full bg-[var(--color-coral)] px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90"
				>
					Retour aux histoires
				</a>
			</div>

			<div id="story-locked" class="hidden rounded-3xl bg-white p-8 text-center shadow-lg">
				<p id="story-locked-message" class="text-lg font-medium text-neutral-800"></p>
				<a
					id="story-locked-cta"
					href="/app#histoires"
					class="mt-5 inline-block rounded-full bg-[var(--color-coral)] px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90"
				></a>
			</div>

			<article id="story-reader" class="hidden rounded-3xl bg-white p-6 shadow-lg sm:p-8">
				<div class="mb-4 flex justify-center overflow-hidden rounded-2xl bg-[var(--color-pale-pink)]">
					<img id="story-cover" src="" alt="" class="hidden max-h-48 w-full object-contain" />
				</div>
				<h1 id="story-title" class="text-center text-2xl font-semibold text-[var(--color-royal-blue)] sm:text-3xl"></h1>
				<div id="story-description" class="mt-3 text-center text-sm text-neutral-500 [&_p]:m-0"></div>

				<p id="scene-empty" class="hidden py-10 text-center text-sm text-neutral-500">
					Cette histoire n'a pas encore de contenu.
				</p>

				<div id="scene-view" class="hidden">
					<div class="mt-6 flex items-center justify-center overflow-hidden rounded-2xl bg-[var(--color-pale-pink)]">
						<img id="scene-image" src="" alt="" class="max-h-80 w-full object-contain" />
					</div>
					<div id="scene-text" class="mt-6 text-center text-base leading-relaxed text-neutral-700 [&_p]:m-0"></div>

					<div class="mt-8 flex items-center justify-between gap-3">
						<button
							id="scene-prev"
							type="button"
							class="min-w-[100px] rounded-full bg-neutral-100 px-5 py-3 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-200 disabled:cursor-not-allowed disabled:opacity-40"
						>
							&larr; Précédent
						</button>
						<p id="scene-progress" class="text-sm font-medium text-neutral-500"></p>
						<button
							id="scene-next"
							type="button"
							class="min-w-[100px] rounded-full bg-[var(--color-blue)] px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90"
						>
							Suivant &rarr;
						</button>
					</div>

					<button
						id="scene-finish"
						type="button"
						class="mt-6 hidden w-full rounded-full bg-[var(--color-coral)] py-4 text-base font-semibold text-white transition hover:opacity-90 active:scale-95"
					>
						J'ai terminé l'histoire !
					</button>
				</div>
			</article>
		</div>
	</main>

	<script>
		import { checkAppSession } from '../../../lib/appPage';
		import {
			getStoryById,
			listStories,
			listScenes,
			getStoryLockReason,
			getStoryTitle,
			getStoryDescriptionHtml,
			getStoryImageUrl,
			getSceneImageUrl,
			getSceneTextHtml,
			markStoryCompleted,
			type SceneRecord,
		} from '../../../lib/stories';

		const loading = document.getElementById('loading') as HTMLElement;
		const networkWarning = document.getElementById('network-warning') as HTMLElement;
		const content = document.getElementById('story-content') as HTMLElement;
		const notFoundEl = document.getElementById('story-not-found') as HTMLElement;
		const lockedEl = document.getElementById('story-locked') as HTMLElement;
		const lockedMessage = document.getElementById('story-locked-message') as HTMLElement;
		const lockedCta = document.getElementById('story-locked-cta') as HTMLAnchorElement;
		const readerEl = document.getElementById('story-reader') as HTMLElement;
		const titleEl = document.getElementById('story-title') as HTMLElement;
		const descriptionEl = document.getElementById('story-description') as HTMLElement;
		const coverImg = document.getElementById('story-cover') as HTMLImageElement;
		const sceneEmpty = document.getElementById('scene-empty') as HTMLElement;
		const sceneView = document.getElementById('scene-view') as HTMLElement;
		const sceneImage = document.getElementById('scene-image') as HTMLImageElement;
		const sceneText = document.getElementById('scene-text') as HTMLElement;
		const sceneProgress = document.getElementById('scene-progress') as HTMLElement;
		const prevBtn = document.getElementById('scene-prev') as HTMLButtonElement;
		const nextBtn = document.getElementById('scene-next') as HTMLButtonElement;
		const finishBtn = document.getElementById('scene-finish') as HTMLButtonElement;

		const storyId = window.location.pathname.split('/').filter(Boolean).pop() ?? '';

		let scenes: SceneRecord[] = [];
		let sceneIndex = 0;

		function renderScene() {
			if (scenes.length === 0) {
				sceneEmpty.classList.remove('hidden');
				sceneView.classList.add('hidden');
				return;
			}
			const scene = scenes[sceneIndex];
			// pages_histoires.texte is PocketBase rich text (real HTML),
			// authored by Nargis in the admin — safe to render as HTML.
			sceneText.innerHTML = getSceneTextHtml(scene);

			const imgUrl = getSceneImageUrl(scene);
			sceneImage.src = imgUrl ?? '';
			sceneImage.closest('div')!.classList.toggle('hidden', !imgUrl);

			sceneProgress.textContent = `${sceneIndex + 1} / ${scenes.length}`;
			prevBtn.disabled = sceneIndex === 0;

			const isLast = sceneIndex === scenes.length - 1;
			nextBtn.classList.toggle('hidden', isLast);
			finishBtn.classList.toggle('hidden', !isLast);
		}

		prevBtn.addEventListener('click', () => {
			if (sceneIndex > 0) {
				sceneIndex--;
				renderScene();
			}
		});
		nextBtn.addEventListener('click', () => {
			if (sceneIndex < scenes.length - 1) {
				sceneIndex++;
				renderScene();
			}
		});

		async function init() {
			const user = await checkAppSession(networkWarning);
			if (!user) return;

			loading.classList.add('hidden');
			content.classList.remove('hidden');

			const story = await getStoryById(storyId);
			if (!story) {
				notFoundEl.classList.remove('hidden');
				return;
			}

			const allStories = await listStories();
			const index = allStories.findIndex((s) => s.id === story.id);
			const lockReason = getStoryLockReason(story, index, allStories, user);

			if (lockReason === 'premium') {
				lockedMessage.textContent = 'Cette histoire est disponible avec ZOZZO Premium.';
				lockedCta.textContent = 'Découvrir Premium';
				lockedCta.href = '/abonnement';
				lockedEl.classList.remove('hidden');
				return;
			}
			if (lockReason === 'progression') {
				lockedMessage.textContent = "Termine l'histoire précédente pour débloquer celle-ci.";
				lockedCta.textContent = 'Retour aux histoires';
				lockedCta.href = '/app#histoires';
				lockedEl.classList.remove('hidden');
				return;
			}

			titleEl.textContent = getStoryTitle(story) || 'Histoire';
			descriptionEl.innerHTML = getStoryDescriptionHtml(story);
			const coverUrl = getStoryImageUrl(story);
			if (coverUrl) {
				coverImg.src = coverUrl;
				coverImg.alt = '';
				coverImg.classList.remove('hidden');
			}
			readerEl.classList.remove('hidden');

			scenes = await listScenes(story.id);
			renderScene();

			finishBtn.addEventListener('click', async () => {
				finishBtn.disabled = true;
				finishBtn.textContent = 'Enregistrement...';
				try {
					await markStoryCompleted(user, story.id);
					window.location.href = '/app#histoires';
				} catch {
					finishBtn.disabled = false;
					finishBtn.textContent = "J'ai terminé l'histoire !";
				}
			});
		}

		init();
	</script>
</AppLayout>
