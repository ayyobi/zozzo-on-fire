---
// Existing URLs remain valid; newly created stories use lire?id=...
import PocketBase from 'pocketbase';
import StoryLayout from '../../../layouts/StoryLayout.astro';
import StoryReader from '../../../components/histoires/StoryReader.astro';
export async function getStaticPaths() {
	const buildPb = new PocketBase(import.meta.env.PUBLIC_POCKETBASE_URL);
	try {
		const stories = await buildPb.collection('histoires').getFullList({ sort: 'ordre' });
		return stories.map((story) => ({ params: { id: story.id } }));
	} catch {
		// Build-time fetch failed (offline build, collection no longer
		// public, etc.): build with zero story pages rather than failing the
		// whole site build.
		return [];
	}
}
---
<StoryLayout>
  <StoryReader storyId={Astro.params.id} />
</StoryLayout>
