
---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FeaturesHero from '../components/FeaturesHero.astro';
import FeaturesLessons from '../components/FeaturesLessons.astro';
import FeaturesCards from '../components/FeaturesCards.astro';
import FeaturesFun from '../components/FeaturesFun.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="ZOZZO | Fonctionnalités"
	description="Découvrez les fonctionnalités de l'application ZOZZO : histoires, leçons, dictionnaire et mini-jeux pour apprendre la langue des signes en s'amusant."
>
	<Header variant="default" />
	<main>
		<FeaturesHero />
		<FeaturesLessons />
		<FeaturesCards />
		<FeaturesFun />
	</main>
	<Footer />
</Layout>
