---
import MinimalLayout from "../layouts/MinimalLayout.astro";
---

<MinimalLayout
  title="ZOZZO | Bienvenue"
  description="Découvre l'histoire de Zozzo et commence à apprendre la langue des signes !"
  bodyClass="m-0 p-0 bg-white flex flex-col w-full h-[100dvh] overflow-hidden"
>
  <!-- Zone des slides : prend tout l'espace disponible au-dessus de la nav -->
  <div class="relative flex-1 overflow-hidden min-h-0 bg-white">
    <div
      id="slides-track"
      class="flex h-full w-[500vw] transition-transform duration-500 ease-out"
    >
      <!-- ── Slide 1 : Présentation du personnage ── -->
      <div
        class="w-screen h-full shrink-0 overflow-hidden px-4 py-4 sm:px-8 sm:py-6"
      >
        <div
          class="mx-auto flex h-full w-full max-w-4xl flex-col items-center justify-center rounded-[2rem] px-5 py-6 text-center sm:px-8 sm:py-8"
        >
          <img
            src="/images/intro/zozzo-magicienne.png"
            alt="Zozzo, mascotte de l'application"
            class="min-h-0 flex-1 w-auto max-h-[62dvh] object-contain py-2"
          />
          <p
            class="shrink-0 font-title text-4xl font-semibold tracking-wide text-slate-900 sm:text-5xl"
          >
            ZOZZO
          </p>
        </div>
      </div>

      <!-- ── Slide 2 : La magicienne ── -->
      <div
        class="w-screen h-full shrink-0 overflow-hidden px-4 py-4 sm:px-8 sm:py-6"
      >
        <div
          class="mx-auto flex h-full w-full max-w-4xl flex-col items-center rounded-[2rem] px-5 pb-5 pt-6 text-center sm:px-8 sm:pb-7 sm:pt-8"
        >
          <p
            class="shrink-0 font-subtitle text-base font-medium text-slate-900 sm:text-lg"
          >
            on la compare souvent à une magicienne
          </p>
          <img
            src="/images/intro/zozzo-enchantements.png"
            alt="Zozzo déguisée en magicienne avec un chaudron magique"
            class="min-h-0 flex-1 w-auto max-h-[52dvh] object-contain py-3"
          />
          <p class="shrink-0 font-subtitle text-base text-slate-900 sm:text-lg">
            Quand ses mains bougent, on dirait qu'elle<br />prépare des
            enchantements ultra cool
          </p>
        </div>
      </div>

      <!-- ── Slide 3 : Les mains ── -->
      <div
        class="w-screen h-full shrink-0 overflow-hidden px-4 py-4 sm:px-8 sm:py-6"
      >
        <div
          class="mx-auto flex h-full w-full max-w-4xl flex-col items-center rounded-[2rem] px-5 pb-5 pt-6 text-center sm:px-8 sm:pb-7 sm:pt-8"
        >
          <p class="shrink-0 font-subtitle text-base text-slate-900 sm:text-lg">
            Mais Zozzo est encore mieux qu'une magicienne.<br />
            Parce que ses sorts ne lancent pas des éclairs
          </p>
          <img
            src="/images/intro/les-deux-main.png"
            alt="Deux mains ouvertes représentant la langue des signes"
            class="min-h-0 flex-1 w-auto max-h-[52dvh] object-contain py-3"
          />
          <p class="shrink-0 font-subtitle text-base text-slate-900 sm:text-lg">
            ils permettent de parler, de rire, de se comprendre.
          </p>
        </div>
      </div>

      <!-- ── Slide 4 : Populaire ── -->
      <div
        class="w-screen h-full shrink-0 overflow-hidden px-4 py-4 sm:px-8 sm:py-6"
      >
        <div
          class="mx-auto flex h-full w-full max-w-4xl flex-col items-center rounded-[2rem] px-5 pb-5 pt-6 text-center sm:px-8 sm:pb-7 sm:pt-8"
        >
          <p class="shrink-0 font-subtitle text-base text-slate-900 sm:text-lg">
            Avec ses mains magiques, Zozzo communique avec tout le monde.<br />
            Et forcément… elle est super populaire !
          </p>
          <img
            src="/images/intro/zozzo-populaire.png"
            alt="Zozzo et ses amis qui font de la langue des signes"
            class="min-h-0 flex-1 w-auto max-h-[52dvh] object-contain py-3"
          />
          <p
            class="shrink-0 font-subtitle text-base font-medium text-zozzo-bleu-fonce sm:text-lg"
          >
            Parce que son vrai pouvoir, c'est de créer du lien.
          </p>
        </div>
      </div>

      <!-- ── Slide 5 : CTA ── -->
      <div
        class="w-screen h-full shrink-0 overflow-hidden px-4 py-4 sm:px-8 sm:py-6"
      >
        <div
          class="mx-auto flex h-full w-full max-w-4xl flex-col items-center justify-center gap-10 rounded-[2rem] px-5 text-center sm:gap-14 sm:px-8"
        >
          <p class="font-subtitle text-xl text-slate-900 sm:text-2xl">
            Et toi, prêt·e à apprendre<br />la magie de Zozzo ?
          </p>
          <a
            href="/login"
            class="rounded-full bg-zozzo-orange px-10 py-4 text-lg font-medium text-white shadow-[0_12px_24px_-12px_rgba(249,115,22,0.85)] transition hover:-translate-y-0.5 hover:opacity-95 active:scale-95 sm:px-16 sm:py-5 sm:text-xl"
          >
            Commencez !
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Barre de navigation : toujours en bas, ne cache jamais le contenu -->
  <div
    id="nav-bar"
    class="shrink-0 flex items-center justify-between px-4 py-3 sm:px-6 sm:py-4"
  >
    <!-- Flèche précédent -->
    <button
      id="prev-btn"
      aria-label="Slide précédente"
      class="hidden h-12 w-12 items-center justify-center rounded-full bg-zozzo-bleu-clair text-white shadow-md shadow-zozzo-bleu-clair/35 transition hover:-translate-y-0.5 hover:opacity-95 active:scale-95 sm:h-14 sm:w-14"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-5 w-5 sm:h-6 sm:w-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>

    <!-- Espace vide à gauche quand prev est caché -->
    <div id="prev-placeholder" class="h-12 w-12 sm:h-14 sm:w-14"></div>

    <div aria-hidden="true"></div>

    <!-- Flèche suivant -->
    <button
      id="next-btn"
      aria-label="Slide suivante"
      class="flex h-12 w-12 items-center justify-center rounded-full bg-zozzo-bleu-clair text-white shadow-md shadow-zozzo-bleu-clair/35 transition hover:-translate-y-0.5 hover:opacity-95 active:scale-95 sm:h-14 sm:w-14"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-5 w-5 sm:h-6 sm:w-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </button>
  </div>

  <script>
    const track = document.getElementById("slides-track") as HTMLElement;
    const nextBtn = document.getElementById("next-btn") as HTMLButtonElement;
    const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement;
    const prevPlaceholder = document.getElementById(
      "prev-placeholder",
    ) as HTMLElement;

    let current = 0;
    const total = 5;

    function goTo(index) {
      current = index;
      track.style.transform = `translateX(-${current * 100}vw)`;

      if (current === 0) {
        prevBtn.style.display = "none";
        nextBtn.style.display = "flex";
        prevPlaceholder.style.display = "none";
      } else if (current === total - 1) {
        prevBtn.style.display = "none";
        nextBtn.style.display = "none";
        prevPlaceholder.style.display = "none";
      } else {
        prevBtn.style.display = "flex";
        nextBtn.style.display = "flex";
        prevPlaceholder.style.display = "none";
      }
    }

    nextBtn.addEventListener("click", () => {
      if (current < total - 1) goTo(current + 1);
    });

    prevBtn.addEventListener("click", () => {
      if (current > 0) goTo(current - 1);
    });

    // Swipe tactile
    let touchStartX = 0;
    document.addEventListener("touchstart", (e) => {
      touchStartX = e.touches[0].clientX;
    });
    document.addEventListener("touchend", (e) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (diff > 50 && current < total - 1) goTo(current + 1);
      if (diff < -50 && current > 0) goTo(current - 1);
    });

    goTo(0);
  </script>
</MinimalLayout>
