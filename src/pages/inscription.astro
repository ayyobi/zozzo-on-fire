---
import MinimalLayout from "../layouts/MinimalLayout.astro";
---

<MinimalLayout
  title="ZOZZO | Créer un compte"
  description="Crée ton compte ZOZZO et apprends la langue des signes."
  bodyClass="m-0 min-h-dvh flex items-center justify-center px-4 py-12 bg-[var(--color-pale-pink)]"
  navigation="public"
>
  <div class="w-full max-w-xl">
    <div class="mb-8 text-center">
      <a href="/" class="inline-block">
        <img
          src="/images/zozzo-logo.svg"
          alt="ZOZZO"
          class="mx-auto h-10 w-auto"
        />
      </a>
      <h1 class="mt-6 text-3xl font-medium text-neutral-900">
        Créer un compte
      </h1>
      <p class="mt-1 text-sm text-neutral-500">Rejoins l'aventure ZOZZO !</p>
    </div>

    <div class="rounded-3xl bg-white p-8 shadow-lg">
      <p
        id="error-msg"
        class="mb-5 hidden rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-600"
        role="alert"
      >
      </p>

      <form id="register-form" class="flex flex-col gap-5" novalidate>
        <div>
          <label
            for="pseudo"
            class="mb-1.5 block text-sm font-medium text-neutral-800"
            >Pseudo</label
          >
          <input
            type="text"
            id="pseudo"
            name="pseudo"
            required
            minlength="2"
            maxlength="24"
            autocomplete="username"
            placeholder="TonPseudo"
            class="w-full rounded-2xl border border-neutral-200 px-4 py-3 text-sm text-neutral-900 outline-none transition focus:border-[var(--color-coral)]"
          />
        </div>

        <div>
          <label
            for="email"
            class="mb-1.5 block text-sm font-medium text-neutral-800"
            >Email</label
          >
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="ton@email.com"
            class="w-full rounded-2xl border border-neutral-200 px-4 py-3 text-sm text-neutral-900 outline-none transition focus:border-[var(--color-coral)]"
          />
        </div>

        <div>
          <label
            for="age"
            class="mb-1.5 block text-sm font-medium text-neutral-800">Âge</label
          >
          <input
            type="number"
            id="age"
            name="age"
            required
            placeholder="Ex : 8"
            class="w-full rounded-2xl border border-neutral-200 px-4 py-3 text-sm text-neutral-900 outline-none transition focus:border-[var(--color-coral)]"
          />
        </div>

        <div class="border-t border-neutral-100 pt-4">
          <label
            for="password"
            class="mb-1.5 block text-sm font-medium text-neutral-800"
            >Mot de passe</label
          >
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="8"
            autocomplete="new-password"
            placeholder="Au moins 8 caractères"
            class="w-full rounded-2xl border border-neutral-200 px-4 py-3 text-sm text-neutral-900 outline-none transition focus:border-[var(--color-coral)]"
          />
        </div>

        <div>
          <label
            for="passwordConfirm"
            class="mb-1.5 block text-sm font-medium text-neutral-800"
            >Confirmer le mot de passe</label
          >
          <input
            type="password"
            id="passwordConfirm"
            name="passwordConfirm"
            required
            minlength="8"
            autocomplete="new-password"
            placeholder="••••••••"
            class="w-full rounded-2xl border border-neutral-200 px-4 py-3 text-sm text-neutral-900 outline-none transition focus:border-[var(--color-coral)]"
          />
        </div>

        <button
          id="submit-btn"
          type="submit"
          class="mt-2 w-full rounded-full bg-[var(--color-coral)] py-3.5 text-base font-semibold text-white transition hover:opacity-90 active:scale-95 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Créer mon compte
        </button>
      </form>
    </div>

    <p class="mt-6 text-center text-sm text-neutral-500">
      Déjà un compte ?
      <a
        href="/login"
        class="font-semibold text-[var(--color-royal-blue)] hover:underline"
        >Se connecter</a
      >
    </p>
  </div>

  <script>
    import {
      register,
      isLoggedIn,
      friendlyErrorMessage,
    } from "../lib/pocketbase";

    if (isLoggedIn()) {
      window.location.replace("/app");
    }

    const form = document.getElementById("register-form") as HTMLFormElement;
    const errorMsg = document.getElementById("error-msg") as HTMLElement;
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement;

    function val(id: string) {
      return (document.getElementById(id) as HTMLInputElement).value;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const pseudo = val("pseudo").trim();
      const email = val("email").trim();
      const age = val("age");
      const password = val("password");
      const passwordConfirm = val("passwordConfirm");

      errorMsg.classList.add("hidden");
      errorMsg.textContent = "";

      if (password !== passwordConfirm) {
        errorMsg.textContent = "Les mots de passe ne correspondent pas.";
        errorMsg.classList.remove("hidden");
        return;
      }

      const ageNum = parseInt(age, 10);
      if (!age || Number.isNaN(ageNum)) {
        errorMsg.textContent = "Merci d'indiquer un âge valide.";
        errorMsg.classList.remove("hidden");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Création...";

      try {
        await register({
          pseudo,
          email,
          age: ageNum,
          password,
          passwordConfirm,
        });
        window.location.replace("/app?bienvenue=1");
      } catch (error) {
        errorMsg.textContent = friendlyErrorMessage(error);
        errorMsg.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Créer mon compte";
      }
    });
  </script>
</MinimalLayout>
