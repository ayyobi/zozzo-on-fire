---
import MinimalLayout from "../layouts/MinimalLayout.astro";
---

<MinimalLayout
  title="ZOZZO | Connexion"
  description="Connecte-toi à ZOZZO pour apprendre la langue des signes."
  bodyClass="m-0 min-h-screen flex items-center justify-center px-4 py-12 bg-zozzo-beige"
>
  <div class="w-full max-w-md">

      <!-- Titre -->
      <div class="mb-8 text-center">
        <h1 class="font-title text-3xl text-zozzo-text">Connexion</h1>
        <p class="mt-1 text-sm text-gray-500">Content de te revoir !</p>
      </div>

      <!-- Carte formulaire -->
      <div class="rounded-3xl bg-white p-8 shadow-lg">

        <!-- Message d'erreur -->
        <div
          id="error-msg"
          class="mb-5 hidden rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-600"
        ></div>

        <form id="login-form" class="flex flex-col gap-5" novalidate>

          <!-- Email -->
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-zozzo-text">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="ton@email.com"
              class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm text-zozzo-text outline-none transition focus:border-zozzo-orange"
            />
          </div>

          <!-- Mot de passe -->
          <div>
            <label for="password" class="mb-1.5 block text-sm font-medium text-zozzo-text">
              Mot de passe
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
              class="w-full rounded-2xl border border-gray-200 px-4 py-3 text-sm text-zozzo-text outline-none transition focus:border-zozzo-orange"
            />
          </div>

          <!-- Bouton connexion -->
          <button
            id="submit-btn"
            type="submit"
            class="mt-2 w-full rounded-full bg-zozzo-orange py-3.5 text-base font-semibold text-white transition hover:opacity-90 active:scale-95"
          >
            Se connecter
          </button>

        </form>
      </div>

      <!-- Lien vers register -->
      <p class="mt-6 text-center text-sm text-gray-500">
        Pas encore de compte ?{" "}
        <a href="/register" class="font-semibold text-zozzo-bleu-fonce hover:underline">
          Créer un compte
        </a>
      </p>

  </div>

  <script>
    // @ts-nocheck
    import { login, isLoggedIn } from "../lib/backend.js";

    if (isLoggedIn()) {
      window.location.replace("/app");
    }

    const form = document.getElementById("login-form") as HTMLFormElement;
    const errorMsg = document.getElementById("error-msg") as HTMLElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const email = (document.getElementById("email") as HTMLInputElement).value.trim();
      const password = (document.getElementById("password") as HTMLInputElement).value;

      errorMsg.classList.add("hidden");
      errorMsg.textContent = "";

      submitBtn.disabled = true;
      submitBtn.textContent = "Connexion en cours…";

      try {
        await login(email, password);
        window.location.replace("/app");
      } catch (error) {
        const err = error as any;
        errorMsg.textContent =
          err?.status === 400
            ? "Email ou mot de passe incorrect."
            : "Impossible de se connecter. Vérifie ta connexion internet.";
        errorMsg.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Se connecter";
      }
    });
  </script>

</MinimalLayout>
